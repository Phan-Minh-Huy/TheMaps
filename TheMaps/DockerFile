FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/package.json /app/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY --from=build /app/server ./server
COPY --from=build /app/db/schema.sql ./db/schema.sql
COPY --from=build /app/scripts/migrate-postgres.mjs ./scripts/migrate-postgres.mjs
COPY --from=build /app/dist/local ./dist/local

USER node
EXPOSE 3001

CMD ["sh", "-c", "node scripts/migrate-postgres.mjs && node server/node.mjs"]